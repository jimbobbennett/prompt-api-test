# Phoenix API base URL. Local Podman Compose defaults to this address.
PHOENIX_BASE_URL=http://localhost:6006
# Optional when Phoenix authentication is enabled.
# PHOENIX_API_KEY=
# Chrome starts headless with this persistent profile by default. Install Gemini Nano into it first.
# PHOENIX_CHROME_PROFILE=.profiles/chrome
# Optional path when Chrome is installed outside its standard location.
# PHOENIX_CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional Chrome DevTools endpoint to attach to a browser you started yourself.
# PHOENIX_CHROME_CDP_ENDPOINT=http://127.0.0.1:9222
# Optional Phoenix dataset namespace prefix.
PHOENIX_DATASET_PREFIX=prompt-api-demo
# Timeout for each Phoenix LLM judge request, in milliseconds.
PHOENIX_EVAL_TIMEOUT_MS=180000
# Phoenix provider/model already configured for evaluator judging.
# Store OPENAI_API_KEY in Phoenix Settings → Secrets, not in this file.
PHOENIX_JUDGE_MODEL_PROVIDER=OPENAI
PHOENIX_JUDGE_MODEL_NAME=gpt-6-luna
